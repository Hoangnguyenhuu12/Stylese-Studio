# Copy to .env and adjust as needed. .env is gitignored.
# ---- HuggingFace cache: MUST live on D: drive, not C: ----
# HF_HUB_CACHE takes precedence and points the snapshot cache at D:/Models/hf_hub
HF_HOME=D:/Models/hf_home
HF_HUB_CACHE=D:/Models/hf_hub
HUGGINGFACE_HUB_CACHE=D:/Models/hf_hub

# ---- Optional: HF token (for gated dataset Nhat-Quang/VN_Fashion_data) ----
# HF_TOKEN=hf_xxx

# ---- Remote AI Stylist (Cách A: OpenAI-compatible endpoint or Gemini API) ----
# STYLIST_PROVIDER=auto          # auto | openai | gemini | openai,gemini | gemini,openai | local | disabled
# STYLIST_FALLBACK=true          # automatically fall back between openai and gemini on errors/429
# Option 1: OpenAI-compatible (OpenAI, OpenRouter, Groq, Ollama, Colab/Kaggle vLLM)
# STYLIST_API_BASE=https://api.openai.com/v1
# STYLIST_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-4o-mini
# Option 2: Gemini API
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash

# ---- Optional: Weights & Biases (LoRA training logs) ----
# WANDB_API_KEY=xxx
# WANDB_PROJECT=outfitmatch

